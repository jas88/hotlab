# Self-contained .NET single-file executable: the runtime (with its statically linked
# zlib-ng and other native components) is bundled into the binary by design.
hotlab-gateway: embedded-library *
# Debian 12's lintian expects units in /lib/systemd/system; Debian 13 (DEP 17) expects
# /usr/lib/systemd/system. One package serves both, and /lib is /usr/lib on both.
hotlab-gateway: systemd-service-file-outside-lib *
