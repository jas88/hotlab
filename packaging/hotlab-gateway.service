[Unit]
Description=Hotlab RDP gateway (on-demand Proxmox lab VMs)
Documentation=man:hotlab-gateway(1) https://github.com/jas88/hotlab
After=network-online.target
Wants=network-online.target
# A configuration error fails every start: give up after 5 failures in a minute rather than
# retrying forever (e.g. when installed and enabled but not yet configured).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=hotlab
Group=hotlab
ExecStart=/usr/bin/hotlab-gateway
Restart=on-failure
RestartSec=5s
# Two sockets per relayed connection (Hotlab:Gateway:MaxConnections).
LimitNOFILE=65536

# Configuration: /usr/lib/hotlab-gateway/appsettings.json (defaults, replaced on upgrade),
# then /etc/hotlab/appsettings.json (site settings), then credentials, then Environment=.
Environment=HOTLAB_CONFIG_DIR=/etc/hotlab
Environment=HOTLAB_USERS_FILE=/etc/hotlab/users.json

# Secrets. Encrypt each one with systemd-creds (see /usr/share/doc/hotlab-gateway/README.md.gz):
#   systemd-creds encrypt --name=Hotlab__Proxmox__TokenSecret - \
#       /etc/credstore.encrypted/Hotlab__Proxmox__TokenSecret
#   systemd-creds encrypt --name=Hotlab__Tokens__SigningKey - \
#       /etc/credstore.encrypted/Hotlab__Tokens__SigningKey
# then add these two lines, uncommented, to a drop-in (systemctl edit hotlab-gateway). The gateway
# reads $CREDENTIALS_DIRECTORY; "__" in a credential name stands for ":" in the key.
#LoadCredentialEncrypted=Hotlab__Proxmox__TokenSecret:/etc/credstore.encrypted/Hotlab__Proxmox__TokenSecret
#LoadCredentialEncrypted=Hotlab__Tokens__SigningKey:/etc/credstore.encrypted/Hotlab__Tokens__SigningKey

# Listen on 3389 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. The gateway only reads /etc/hotlab (deploy, run by an administrator, writes
# users.json), so the whole file system stays read-only: no ReadWritePaths=.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute= is deliberately not set: the .NET runtime JIT-compiles code into
# writable+executable memory (even with ReadyToRun images), and would fail to start.

[Install]
WantedBy=multi-user.target
